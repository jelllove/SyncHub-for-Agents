{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jelllove/SyncHub-for-Agents/schemas/validation-receipt.v1.schema.json",
  "title": "SyncHub validation receipt v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "status", "checks", "source"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "repository-validation"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "worktreeDirty": {
      "type": "boolean"
    },
    "platform": {
      "type": "string"
    },
    "nodeVersion": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": {
      "enum": ["running", "passed", "failed"]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "scope": {
          "const": "git-listed-working-tree-bytes-v1"
        },
        "status": {
          "enum": ["pending", "running", "stable", "changed", "error"]
        },
        "changedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "string"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "command", "args", "status", "durationMs", "log"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "command": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": ["pending", "running", "passed", "failed", "not-run"]
          },
          "durationMs": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "log": {
            "type": "string"
          }
        }
      }
    }
  }
}
