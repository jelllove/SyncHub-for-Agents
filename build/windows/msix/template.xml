<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="agentconfigsync.exe"
        Arguments=""
        InstallLocation="C:\Program Files\AgentConfigSync\AgentConfigSync">
    </Installer>
    <PackageInformation
        PackageName="AgentConfigSync"
        PackageDisplayName="AgentConfigSync"
        PublisherName="CN=AgentConfigSync"
        PublisherDisplayName="AgentConfigSync"
        Version="0.1.0.0"
        PackageDescription="Synchronize AI agent configuration and sessions">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.qinqingxu.agentconfigsync"
                Description="Synchronize AI agent configuration and sessions"
                DisplayName="AgentConfigSync"
                ExecutableName="agentconfigsync.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>AgentConfigSync</DisplayName>
            <PublisherDisplayName>AgentConfigSync</PublisherDisplayName>
            <Description>Synchronize AI agent configuration and sessions</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="agentconfigsync.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
