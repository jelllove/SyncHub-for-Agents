<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="synchub.exe"
        Arguments=""
        InstallLocation="C:\Program Files\SyncHub\SyncHub">
    </Installer>
    <PackageInformation
        PackageName="SyncHub"
        PackageDisplayName="SyncHub"
        PublisherName="CN=SyncHub"
        PublisherDisplayName="SyncHub"
        Version="0.1.0.0"
        PackageDescription="Synchronize AI agent configuration and sessions">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.qinqingxu.synchub"
                Description="Synchronize AI agent configuration and sessions"
                DisplayName="SyncHub"
                ExecutableName="synchub.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>SyncHub</DisplayName>
            <PublisherDisplayName>SyncHub</PublisherDisplayName>
            <Description>Synchronize AI agent configuration and sessions</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="synchub.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
