{
  "name": "synchub-for-agents",
  "version": "0.1.1",
  "description": "Verified cross-platform installer and launcher for SyncHub for Agents desktop",
  "type": "module",
  "license": "MIT",
  "author": "SyncHub for Agents contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jelllove/SyncHub-for-Agents.git",
    "directory": "packages/npm-installer"
  },
  "homepage": "https://github.com/jelllove/SyncHub-for-Agents",
  "bugs": "https://github.com/jelllove/SyncHub-for-Agents/issues",
  "bin": {
    "synchub-for-agents": "bin/synchub-for-agents.mjs"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/install.mjs",
    "scripts/check-docs.mjs",
    "release.json",
    "docs/",
    "README.md",
