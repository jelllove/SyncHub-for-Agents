{
  "name": "SyncHub for Agents - Ubuntu 24.04",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/synchub-for-agents,type=bind",
  "workspaceFolder": "/workspaces/synchub-for-agents",
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "privileged": false,
  "init": true,
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges"
  ],
  "postCreateCommand": [
    "node",
    "scripts/dev.mjs",
    "setup"
  ],
  "waitFor": "postCreateCommand"
}
